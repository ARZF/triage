# Set these in your process environment; the application does not load .env files itself.
# Or copy to ignored .env and launch with the uv --env-file command in README.md.
# Allowed values: INFO, WARNING, ERROR, CRITICAL (case insensitive).
APP_LOG_LEVEL=INFO
# Never put real credentials in this file.
# SQLite file path; must be non-empty. Synthetic data only.
APP_DB_PATH=healthcare_agent.db
# Optional OpenAI-compatible endpoint; include /v1 here if the provider needs it.
# URL and model together enable calls. Leave both empty for synthetic fallback.
APP_LLM_BASE_URL=
APP_LLM_MODEL=
# Optional bearer key; never put real credentials in this example.
APP_LLM_API_KEY=
# Float from 1 to 120, default 30.
APP_LLM_TIMEOUT_SECONDS=30

# Independent doctor-Codex chat, using the server operator's dedicated Codex login.
# Existing absolute directory OUTSIDE this repo and your development Codex home.
# Leave empty to keep inference unavailable. See README for isolated login/setup.
APP_CODEX_HOME=
# Optional; otherwise use the dedicated runtime's configured default model.
APP_CODEX_MODEL=

# Demo authentication and request lifetime. The application does not load this file.
APP_COOKIE_SECURE=false
APP_SESSION_TTL_HOURS=12
# Optional synthetic seed-doctor password (8-128 characters); never use a real password here.
APP_DEMO_DOCTOR_PASSWORD=
# Local-demo shortcut only: true skips admin review for new doctor registrations.
APP_DOCTOR_AUTO_VERIFY=false
APP_REQUEST_TTL_MINUTES=30
# Both or neither. Lowercase username (3-32 ASCII letters/digits/_.-); password 12-128 characters.
# Synthetic demo credentials only; keep real secrets out of this file.
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=
